{
  "name": "axios-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Live-Demo zu Axios HTTP – KBE WiSe 26/27, HTW Berlin",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev\"",
    "build": "npm run type-check && vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "axios": "1.21.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "express": "^5.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
